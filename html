<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0A4A30">
<meta name="description" content="NOVERDE: saia do vermelho, organize suas dívidas e chegue a 20% de sobra todo mês.">
<title>NOVERDE | Saia do vermelho e fique no verde</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%230A4A30'/%3E%3Cpath d='M9 20l5-5 4 3 6-7' stroke='%2378E2A6' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F3F5F4;--surface:#FFFFFF;--surface2:#F7F9F8;--ink:#0F1A15;--muted:#5E6B65;--line:#E2E8E5;
  --brand:#0A4A30;--brand2:#0E6B45;--brandInk:#FFFFFF;--accent:#78E2A6;--brandSoft:#E3F4EB;
  --ok:#11804A;--okbg:#E2F4EA;--warn:#A35F00;--warnbg:#FDF1DC;--bad:#C4302B;--badbg:#FCE6E4;
  --font:"Plus Jakarta Sans",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --r:18px;
  box-sizing:border-box;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0B1210;--surface:#141D19;--surface2:#18231E;--ink:#E9F0EC;--muted:#97A69F;--line:#25322C;
  --brand:#0C3D29;--brand2:#13583A;--brandSoft:#15352A;
  --ok:#4FCB86;--okbg:#123222;--warn:#F2B04C;--warnbg:#3A2B10;--bad:#F27A71;--badbg:#3E1A17;
}}
:root[data-theme="dark"]{
  --bg:#0B1210;--surface:#141D19;--surface2:#18231E;--ink:#E9F0EC;--muted:#97A69F;--line:#25322C;
  --brand:#0C3D29;--brand2:#13583A;--brandSoft:#15352A;
  --ok:#4FCB86;--okbg:#123222;--warn:#F2B04C;--warnbg:#3A2B10;--bad:#F27A71;--badbg:#3E1A17;
}
*,*::before,*::after{box-sizing:inherit}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{margin:0;font-weight:700;letter-spacing:-.01em}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--brand2);outline-offset:2px}
svg.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
.tab{font-variant-numeric:tabular-nums}

/* casca */
.shell{display:grid;grid-template-columns:1fr;min-height:100vh}
.side{display:none}
.mtop{display:flex;align-items:center;justify-content:space-between;padding:calc(14px + env(safe-area-inset-top,0px)) 18px 14px;background:var(--brand);color:var(--brandInk)}
.main{min-width:0}
#app{padding:0 0 calc(96px + env(safe-area-inset-bottom,0px))}
.content{max-width:1080px;margin:0 auto;padding:0 16px}
.brandmark{display:flex;align-items:center;gap:10px;font-weight:800;font-size:19px;letter-spacing:.06em}
.brandmark .m{width:32px;height:32px;border-radius:10px;background:rgba(255,255,255,.12);display:grid;place-items:center}
.brandmark .m svg{width:20px;height:20px;stroke:var(--accent);stroke-width:3}
.brandmark small{display:block;font-size:11px;font-weight:500;letter-spacing:0;opacity:.7}
.iconbtn{border:0;background:transparent;color:inherit;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;cursor:pointer}
.iconbtn:hover{background:rgba(127,127,127,.14)}

nav.bottom{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--surface);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px))}
nav.bottom button{border:0;background:transparent;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 0;font-size:11px;font-weight:600;color:var(--muted);cursor:pointer;border-radius:12px}
nav.bottom button[aria-current="page"]{color:var(--brand2)}
:root[data-theme="dark"] nav.bottom button[aria-current="page"]{color:var(--accent)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) nav.bottom button[aria-current="page"]{color:var(--accent)}}

@media (min-width:900px){
  .shell{grid-template-columns:248px 1fr}
  .side{display:flex;flex-direction:column;gap:6px;position:sticky;top:0;height:100vh;background:var(--brand);color:var(--brandInk);padding:24px 16px}
  .side .brandmark{padding:4px 10px 26px}
  .side nav button{width:100%;border:0;background:transparent;color:rgba(255,255,255,.75);display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;font-weight:600;cursor:pointer;text-align:left}
  .side nav button:hover{background:rgba(255,255,255,.07);color:#fff}
  .side nav button[aria-current="page"]{background:rgba(255,255,255,.12);color:#fff}
  .side .foot{margin-top:auto;font-size:12px;opacity:.6;padding:0 10px}
  .mtop,nav.bottom,.heroMark{display:none}
  .heroTop{justify-content:flex-end}
  #app{padding:28px 0 48px}
  .content{padding:0 32px}
}

/* cartões */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:20px}
.card h3{font-size:16px}
.cardhead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.grid{display:grid;gap:16px}
.g2{grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr))}
.muted{color:var(--muted)}
.small{font-size:13px}
.ok{color:var(--ok)}.warn{color:var(--warn)}.bad{color:var(--bad)}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;padding:4px 10px;border-radius:999px;white-space:nowrap}
.chip.ok{background:var(--okbg)}.chip.warn{background:var(--warnbg)}.chip.bad{background:var(--badbg)}.chip.neutral{background:var(--surface2);color:var(--muted);border:1px solid var(--line)}
.btn{border:1px solid var(--line);background:var(--surface);padding:11px 18px;border-radius:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.btn:hover{background:var(--surface2)}
.btn.primary{background:var(--brand2);border-color:var(--brand2);color:#fff}
.btn.primary:hover{background:var(--brand)}
.btn.sm{padding:7px 12px;font-size:13px;border-radius:10px}
.btn.link{border:0;background:transparent;color:var(--brand2);padding:6px 8px}
:root[data-theme="dark"] .btn.link{color:var(--accent)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .btn.link{color:var(--accent)}}
.btn.danger{color:var(--bad)}
.btn.block{width:100%}

/* hero estilo banco */
.hero{background:var(--brand);color:var(--brandInk);padding:8px 0 64px}
@media (min-width:900px){.hero{border-radius:24px;padding:28px 0 72px;margin:0 32px}.hero .content{padding:0 28px}}
.heroTop{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.monthsw{display:inline-flex;align-items:center;gap:2px;background:rgba(255,255,255,.1);border-radius:999px;padding:3px}
.monthsw.light{background:var(--surface);border:1px solid var(--line)}
.monthsw button{border:0;background:transparent;color:inherit;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;cursor:pointer}
.monthsw button:hover{background:rgba(127,127,127,.16)}
.monthsw button svg{width:18px;height:18px}
.monthsw span{min-width:118px;text-align:center;font-weight:700;font-size:14px}
.balLbl{display:flex;align-items:center;gap:6px;margin-top:22px;font-size:14px;opacity:.8}
.balLbl button{border:0;background:transparent;color:inherit;cursor:pointer;padding:4px;display:grid;opacity:.9}
.balLbl svg{width:18px;height:18px}
.bal{font-size:clamp(34px,7vw,46px);font-weight:800;letter-spacing:-.03em;margin:2px 0 6px}
.heroRow{display:flex;gap:22px;flex-wrap:wrap;font-size:14px}
.heroRow div{display:flex;align-items:center;gap:6px}
.heroRow svg{width:16px;height:16px}
.heroRow .up{color:var(--accent)}
.heroRow .down{color:#FFB4AE}
.goal{margin-top:22px;background:rgba(255,255,255,.08);border-radius:14px;padding:14px}
.goal .gl{display:flex;justify-content:space-between;align-items:center;font-size:13px;gap:10px;flex-wrap:wrap}
.gbar{position:relative;height:10px;background:rgba(255,255,255,.14);border-radius:99px;margin-top:10px;overflow:hidden}
.gbar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px;background:var(--accent);transition:width .7s cubic-bezier(.2,.8,.2,1)}
.gbar i.neg{background:#FF8A80}
.phase{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.12);padding:6px 12px;border-radius:999px;font-size:13px;font-weight:700}
.phase b{width:8px;height:8px;border-radius:50%;background:var(--accent)}
.phase.p-bad b{background:#FF8A80}.phase.p-warn b{background:#FFC965}

.lift{margin-top:-44px;position:relative}
.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px 8px}
.quick button{border:0;background:transparent;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:12px;font-weight:600;cursor:pointer;color:var(--ink);padding:2px}
.quick span.c{width:52px;height:52px;border-radius:50%;background:var(--brandSoft);color:var(--brand2);display:grid;place-items:center}
:root[data-theme="dark"] .quick span.c{color:var(--accent)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .quick span.c{color:var(--accent)}}
.quick button:hover span.c{background:var(--okbg)}

.alertbox{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start;border-radius:var(--r);padding:18px;border:1px solid}
.alertbox.a-bad{background:var(--badbg);border-color:color-mix(in srgb,var(--bad) 35%,transparent)}
.alertbox.a-warn{background:var(--warnbg);border-color:color-mix(in srgb,var(--warn) 35%,transparent)}
.alertbox.a-ok{background:var(--okbg);border-color:color-mix(in srgb,var(--ok) 35%,transparent)}
.alertbox .ai.bad{color:var(--bad)}.alertbox .ai.warn{color:var(--warn)}.alertbox .ai.ok{color:var(--ok)}
.alertbox .ai{width:44px;height:44px;border-radius:12px;background:var(--surface);display:grid;place-items:center}
.alertbox h2{font-size:18px;margin-bottom:4px}
.alertbox p{margin:0}

/* listas */
.li{display:grid;grid-template-columns:42px 1fr auto;gap:12px;align-items:center;padding:12px 0;border-top:1px solid var(--line)}
.li:first-child{border-top:0}
.ico{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--surface2);border:1px solid var(--line)}
.ico svg{width:20px;height:20px}
.ico.ok{background:var(--okbg);border-color:transparent;color:var(--ok)}.ico.warn{background:var(--warnbg);border-color:transparent;color:var(--warn)}.ico.bad{background:var(--badbg);border-color:transparent;color:var(--bad)}
.li .t{font-weight:600}
.li .s{font-size:13px;color:var(--muted)}
.li .v{font-weight:700;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.dayh{font-size:12px;font-weight:700;color:var(--muted);padding:16px 0 4px}
.li.tx{cursor:pointer;margin:0 -8px;padding:12px 8px;gap:10px}
.li.tx:hover{background:var(--surface2)}

.li.tx .acts{display:flex;align-items:center;gap:0}
.li.tx .acts .iconbtn{width:34px;height:34px;color:var(--muted)}
.li.tx .acts .iconbtn svg{width:18px;height:18px}
.hintTap{font-size:12px;color:var(--muted);margin:2px 0 6px}
.rank{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-weight:800}
.rank.bad{background:var(--badbg);color:var(--bad)}.rank.warn{background:var(--warnbg);color:var(--warn)}

.bar{position:relative;height:8px;border-radius:99px;background:var(--surface2);border:1px solid var(--line);margin-top:8px}
.bar i{position:absolute;left:0;top:-1px;bottom:-1px;border-radius:99px}
.bar i.ok{background:var(--ok)}.bar i.warn{background:var(--warn)}.bar i.bad{background:var(--bad)}.bar i.neutral{background:var(--muted)}
.bar b{position:absolute;top:-5px;bottom:-5px;width:2px;border-radius:2px;background:var(--ink);opacity:.6}

.donutWrap{display:grid;grid-template-columns:160px 1fr;gap:20px;align-items:center}
@media (max-width:440px){.donutWrap{grid-template-columns:1fr;justify-items:center}}
.legend{display:grid;gap:8px;width:100%}
.legend div{display:grid;grid-template-columns:10px 1fr auto auto;gap:8px;align-items:center;font-size:13px}
.legend i{width:10px;height:10px;border-radius:3px}
.sd{width:8px;height:8px;border-radius:50%}
.sd.ok{background:var(--ok)}.sd.warn{background:var(--warn)}.sd.bad{background:var(--bad)}.sd.neutral{background:var(--line)}

/* categorias */
.cat{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.cat + .cat{margin-top:10px}
.cat>button{all:unset;box-sizing:border-box;width:100%;display:grid;grid-template-columns:44px 1fr auto 20px;gap:14px;align-items:center;padding:16px 18px;cursor:pointer}
.cat>button:focus-visible{outline:2px solid var(--brand2);outline-offset:-2px}
.cat .ico{width:44px;height:44px}
.cat .chev{display:grid;place-items:center;transition:transform .2s;color:var(--muted)}
.cat.open .chev{transform:rotate(180deg)}
.cbody{display:none;padding:2px 18px 18px 76px}
.cat.open .cbody{display:block}
.cbody h4{font-size:13px;color:var(--muted);margin:16px 0 6px;font-weight:700}
.cbody p{margin:0}
.cbody ul{margin:0;padding-left:18px}
.cbody li{margin:3px 0}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{font-size:12px;font-weight:600;background:var(--surface2);border:1px solid var(--line);padding:4px 10px;border-radius:999px}
.status{font-weight:700;padding:12px 14px;border-radius:12px;margin-top:6px}
.status.ok{background:var(--okbg)}.status.warn{background:var(--warnbg)}.status.bad{background:var(--badbg)}.status.neutral{background:var(--surface2)}
@media (max-width:420px){.li.tx{grid-template-columns:38px 1fr auto}.li.tx .ico{width:38px;height:38px}.li.tx .v{font-size:14px}}
@media (max-width:560px){.cbody{padding-left:18px}.cat>button{grid-template-columns:44px 1fr 20px}.cat>button .pc{display:none}}

/* dívidas */
.debt{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px}
.debt + .debt{margin-top:10px}
.debt .top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.meter{height:12px;border-radius:99px;background:var(--surface2);border:1px solid var(--line);position:relative;overflow:hidden;margin-top:10px}
.meter i{position:absolute;left:0;top:0;bottom:0}
.meter span{position:absolute;top:0;bottom:0;width:2px;background:var(--ink);opacity:.35}
.steps{list-style:none;counter-reset:s;margin:0;padding:0}
.steps li{counter-increment:s;position:relative;padding:12px 0 12px 44px;border-top:1px solid var(--line)}
.steps li:first-child{border-top:0}
.steps li::before{content:counter(s);position:absolute;left:0;top:12px;width:30px;height:30px;border-radius:10px;background:var(--brandSoft);color:var(--brand2);font-weight:800;display:grid;place-items:center;font-size:13px}
:root[data-theme="dark"] .steps li::before{color:var(--accent)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .steps li::before{color:var(--accent)}}

/* formulários */
label.f{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:600;color:var(--muted)}
input[type=text],input[type=number],input[type=date],select{width:100%;min-height:48px;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);font-size:15px}
input:focus{outline:2px solid var(--brand2);outline-offset:-1px;border-color:transparent}
.money{display:flex;align-items:baseline;gap:6px;border-bottom:2px solid var(--line);padding:6px 0}
.money:focus-within{border-color:var(--brand2)}
.money span{font-size:22px;font-weight:700;color:var(--muted)}
.money input{border:0;padding:0;min-height:0;font-size:34px;font-weight:800;background:transparent;outline:none;letter-spacing:-.02em}
.seg{display:grid;grid-template-columns:1fr 1fr;background:var(--surface2);border:1px solid var(--line);border-radius:14px;padding:4px}
.seg button{border:0;background:transparent;padding:10px;border-radius:10px;font-weight:700;cursor:pointer;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.catpick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.catpick button{border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:10px 4px;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;font-weight:600;cursor:pointer;color:var(--ink);line-height:1.2;text-align:center}
.catpick button[aria-pressed="true"]{border-color:var(--brand2);background:var(--brandSoft);box-shadow:inset 0 0 0 1px var(--brand2)}
.catpick button svg{width:20px;height:20px}
.explain{background:var(--surface2);border:1px solid var(--line);border-radius:14px;padding:12px 14px;font-size:13px}
.explain strong{display:block;margin-bottom:4px;font-size:14px}
.explain .tags{margin-top:8px}
.switch{display:flex;align-items:center;justify-content:space-between;gap:12px;font-weight:600}
.switch input{appearance:none;width:46px;height:28px;border-radius:99px;background:var(--line);position:relative;cursor:pointer;transition:.2s;flex:none;margin:0}
.switch input::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:.2s}
.switch input:checked{background:var(--brand2)}
.switch input:checked::after{left:21px}

/* sheet */
.sheetbg{position:fixed;inset:0;z-index:40;background:rgba(5,15,10,.5);display:none;align-items:flex-end;justify-content:center}
.sheetbg.show{display:flex}
.sheet{background:var(--surface);width:100%;max-width:520px;max-height:92vh;overflow:auto;border-radius:24px 24px 0 0;padding:10px 20px calc(24px + env(safe-area-inset-bottom,0px));animation:up .28s cubic-bezier(.2,.8,.2,1)}
.sheet .grab{width:40px;height:4px;border-radius:9px;background:var(--line);margin:0 auto 10px}
.sheet .sh{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.sheet .sh h2{font-size:19px}
@media (min-width:640px){.sheetbg{align-items:center}.sheet{border-radius:24px;padding-bottom:24px}.sheet .grab{display:none}}
@keyframes up{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}

.toast{position:fixed;left:50%;bottom:calc(92px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(16px);background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:14px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:60;max-width:90vw;text-align:center}
.toast.show{opacity:1;transform:translateX(-50%)}
.toast.act{pointer-events:auto;display:flex;align-items:center;gap:14px;text-align:left}
.toast button{border:0;background:transparent;color:var(--accent);font-weight:800;cursor:pointer;padding:4px 2px;white-space:nowrap}
@media (min-width:900px){.toast{bottom:32px}}
.empty{text-align:center;padding:30px 12px;color:var(--muted)}
.pagehead{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:22px 0 16px}
.pagehead h1{font-size:24px}
@media (min-width:900px){.pagehead{margin-top:0}}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px}
.kpi .n{display:block;font-size:22px;font-weight:800;margin-top:2px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}

/* boas-vindas */
.welcome{min-height:100vh;background:var(--brand);color:#fff;display:grid;place-items:center;padding:24px}
.welcome .box{width:100%;max-width:440px}
.welcome h1{font-size:clamp(30px,7vw,40px);line-height:1.1;letter-spacing:-.03em;margin:34px 0 12px}
.welcome p{opacity:.8;margin:0 0 26px}
.welcome .money{border-color:rgba(255,255,255,.25)}
.welcome .money span,.welcome .money input{color:#fff}
.welcome .money input::placeholder{color:rgba(255,255,255,.4)}
.welcome .btn.primary{background:var(--accent);border-color:var(--accent);color:#06301F}
.welcome .btn.ghost{background:transparent;border-color:rgba(255,255,255,.3);color:#fff}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="root"></div>
