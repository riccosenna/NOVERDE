const TIPOS = {cartao:["Cartão de crédito (rotativo)",14],cheque:["Cheque especial",7.5],pessoal:["Empréstimo pessoal",5],consignado:["Consignado",1.8],financ:["Financiamento",2],crediario:["Crediário de loja",4],acordo:["Acordo negociado",2],contas:["Conta em atraso (luz, água, aluguel)",2],outro:["Outra",3]};

/* ========== utilidades ========== */
const brl = (v,d=2) => (v<0?"-":"")+"R$ "+Math.abs(v).toLocaleString("pt-BR",{minimumFractionDigits:d,maximumFractionDigits:d});
const brl0 = v => brl(v,0);
const pct = v => (Math.round(v*10)/10).toLocaleString("pt-BR")+"%";
const esc = s => String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const uid = () => Math.random().toString(36).slice(2,9)+Date.now().toString(36);
const today = () => { const d=new Date(); d.setMinutes(d.getMinutes()-d.getTimezoneOffset()); return d.toISOString().slice(0,10); };
const curM = () => today().slice(0,7);
const parseV = v => { let s=String(v).trim().replace(/[^\d.,-]/g,""); if(s.includes(",")) s=s.replace(/\./g,"").replace(",","."); const n=parseFloat(s); return isFinite(n)?n:0; };
const shiftM = (m,k) => { const [y,mo]=m.split("-").map(Number); const d=new Date(y,mo-1+k,1); return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0"); };
const mLabel = m => { const [y,mo]=m.split("-").map(Number); const t=new Date(y,mo-1,1).toLocaleDateString("pt-BR",{month:"long",year:"numeric"}); return t.charAt(0).toUpperCase()+t.slice(1); };

const KEY="noverde-v1";
let S = {renda:0,nome:"",lanc:[],fixos:[],dividas:[],hide:false};
try{ const raw=localStorage.getItem(KEY); if(raw) S=Object.assign(S,JSON.parse(raw)); }catch(e){}
let mes=curM(), view="inicio", openCats=new Set(), extraDiv=null;

function save(){ try{ localStorage.setItem(KEY,JSON.stringify(S)); }catch(e){ toast("Não foi possível salvar neste navegador"); } }
function toast(m,label,fn){
  const t=document.getElementById("toast"); t.innerHTML=""; const sp=document.createElement("span"); sp.textContent=m; t.appendChild(sp);
  t.classList.toggle("act",!!fn);
  if(fn){ const b=document.createElement("button"); b.textContent=label; b.onclick=()=>{ t.classList.remove("show","act"); fn(); }; t.appendChild(b); }
  t.classList.add("show"); clearTimeout(toast.t); toast.t=setTimeout(()=>t.classList.remove("show","act"),fn?6000:2400);
}

/* ========== cálculo ========== */
function calc(m){
  const lanc=S.lanc.filter(l=>l.data.slice(0,7)===m);
  const fixos=S.fixos.filter(f=>f.desde<=m && (!f.ate||f.ate>=m));
  const extras=lanc.filter(l=>l.tipo==="entrada").reduce((a,l)=>a+l.valor,0);
  const renda=S.renda+extras;
  const g=Object.fromEntries(CATS.map(c=>[c.k,0]));
  lanc.filter(l=>l.tipo==="saida").forEach(l=>g[l.cat]+=l.valor);
  fixos.forEach(f=>g[f.cat]+=f.valor);
  const saidas=Object.values(g).reduce((a,b)=>a+b,0);
  const saldo=renda-saidas, sp=renda>0?saldo/renda*100:0;
  const temDiv=S.dividas.some(d=>d.saldo>0);
  const rows=CATS.map(c=>{
    const ideal=renda*c.p/100, v=g[c.k];
    let st;
    if(c.k==="dividas") st = v===0?(temDiv?"warn":"neutral"):v<=renda*.15?"ok":v<=ideal?"warn":"bad";
    else st = v===0?"neutral":v<=ideal?"ok":v<=ideal*1.15?"warn":"bad";
    return {...c,ideal,g:v,st,ex:Math.max(0,v-ideal),real:renda>0?v/renda*100:0};
  });
  return {renda,extras,saidas,saldo,sp,rows,lanc,fixos,temDiv};
}
function fase(r){
  if(r.saidas===0) return {t:"Comece lançando seus gastos",c:"warn"};
  if(r.saldo<0) return {t:"Fase 1 de 3: sair do vermelho",c:"bad"};
  if(r.temDiv) return {t:"Fase 2 de 3: quitar as dívidas",c:"warn"};
  if(r.sp<20) return {t:"Fase 3 de 3: chegar aos 20%",c:"warn"};
  return {t:"Você está no verde",c:"ok"};
}
function simular(extra){
  const ds=S.dividas.filter(d=>d.saldo>0).map(d=>({...d,b:d.saldo,r:d.juros/100}));
  if(!ds.length) return null;
  const budget=ds.reduce((a,d)=>a+d.parcela,0)+extra;
  let m=0,juros=0; const quit={};
  while(ds.some(d=>d.b>0.01)&&m<480){
    m++; let left=budget;
    ds.forEach(d=>{ if(d.b>0){const j=d.b*d.r; d.b+=j; juros+=j;} });
    ds.forEach(d=>{ if(d.b>0){const p=Math.min(d.parcela,d.b,left); d.b-=p; left-=p;} });
    ds.slice().sort((a,b)=>b.r-a.r).forEach(d=>{ if(d.b>0&&left>0){const p=Math.min(d.b,left); d.b-=p; left-=p;} });
    ds.forEach(d=>{ if(d.b<=0.01&&!quit[d.id]) quit[d.id]=m; });
  }
  return {m,juros,quit,ok:m<480};
}
const prazo = m => m<12 ? `${m} ${m===1?"mês":"meses"}` : (()=>{const a=Math.floor(m/12),r=m%12;return `${a} ${a===1?"ano":"anos"}${r?` e ${r} ${r===1?"mês":"meses"}`:""}`})();

