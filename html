const NAV=[["inicio","Início","home"],["extrato","Extrato","list"],["categorias","Categorias","grid"],["dividas","Dívidas","card"],["perfil","Perfil","user"]];
const mark = (sub=true) => `<div class="brandmark"><span class="m">${I("trend")}</span><span>NOVERDE${sub?'<small>Do vermelho aos 20%</small>':""}</span></div>`;
function monthSw(light){ return `<div class="monthsw ${light?"light":""}"><button data-m="-1" aria-label="Mês anterior">${I("left")}</button><span>${mLabel(mes)}</span><button data-m="1" aria-label="Próximo mês">${I("right")}</button></div>`; }

function render(){
  const root=document.getElementById("root");
  if(!(S.renda>0)){ root.innerHTML=welcome(); bindWelcome(); return; }
  const r=calc(mes);
  const navBtns = NAV.map(([k,n,ic])=>`<button data-v="${k}" ${view===k?'aria-current="page"':""}>${I(ic)}<span>${n}</span></button>`).join("");
  const body = ({inicio,extrato,categorias,dividas,perfil})[view](r);
  root.innerHTML = `<div class="shell">
    <aside class="side">${mark()}<nav>${navBtns}</nav><div class="foot">Seus dados ficam salvos apenas neste navegador.</div></aside>
    <div class="main">
      ${view==="inicio"?"":`<header class="mtop">${mark(false)}<button class="iconbtn" data-v="perfil" aria-label="Perfil">${I("user")}</button></header>`}
      <main id="app">${body}</main>
    </div></div>
    <nav class="bottom">${navBtns}</nav>`;
  bindCommon(r);
}

