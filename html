/* ========== linha de lançamento (toque para editar) ========== */
function txRow(l,fixo){
  const c=l.tipo==="entrada"?{n:"Entrada extra",ic:"up"}:CAT[l.cat]; const nm=esc(l.desc||c.n);
  return `<div class="li tx" role="button" tabindex="0" data-open="${fixo?"f":"l"}:${l.id}" aria-label="Editar ${nm}"><span class="ico ${l.tipo==="entrada"?"ok":""}">${I(c.ic)}</span>
    <div><div class="t">${nm}</div><div class="s">${c.n}${fixo?" (fixo mensal)":""}</div></div>
    <div class="acts"><span class="v ${l.tipo==="entrada"?"ok":""}">${l.tipo==="entrada"?"+ ":"- "}${brl(l.valor)}</span>
    <button class="iconbtn" data-edit-tx="${fixo?"f":"l"}:${l.id}" aria-label="Editar ${nm}">${I("pencil")}</button>
    <button class="iconbtn" data-del="${fixo?"f":"l"}:${l.id}" aria-label="Excluir ${nm}">${I("trash")}</button></div></div>`;
}
function findTx(key){ const [t,id]=key.split(":"); return t==="f"?{...S.fixos.find(x=>x.id===id),tipo:"saida",fixo:true}:{...S.lanc.find(x=>x.id===id),fixo:false}; }
function delTx(key){
  const [t,id]=key.split(":");
  if(t==="f"){
    const f=S.fixos.find(x=>x.id===id); if(!f) return;
    if(!confirm("Parar de repetir este gasto fixo a partir deste mês? Os meses anteriores continuam com ele.")) return;
    const before=JSON.parse(JSON.stringify(S.fixos));
    if(f.desde>=mes) S.fixos=S.fixos.filter(x=>x.id!==id); else f.ate=shiftM(mes,-1);
    save(); render(); toast("Gasto fixo removido","Desfazer",()=>{ S.fixos=before; save(); render(); });
  } else {
    const i=S.lanc.findIndex(x=>x.id===id); if(i<0) return; const old=S.lanc[i];
    S.lanc.splice(i,1); save(); render();
    toast(old.tipo==="entrada"?"Entrada excluída":"Gasto excluído","Desfazer",()=>{ S.lanc.push(old); save(); render(); });
  }
}

/* ========== extrato ========== */
function extrato(r){
  const items=[...r.lanc].sort((a,b)=>b.data.localeCompare(a.data)||0);
  const row=txRow;
  const cap=t=>t.charAt(0).toUpperCase()+t.slice(1);
  let groups="", last="";
  items.forEach(l=>{ if(l.data!==last){ last=l.data; const [y,m,d]=l.data.split("-").map(Number); groups+=`<div class="dayh">${cap(new Date(y,m-1,d).toLocaleDateString("pt-BR",{weekday:"long",day:"numeric",month:"long"}))}</div>`; } groups+=row(l,false); });
  const fixHtml = r.fixos.length?`<div class="dayh">Gastos fixos do mês</div>${r.fixos.map(f=>row({...f,tipo:"saida"},true)).join("")}`:"";
  return `<div class="content"><div class="pagehead"><h1>Extrato</h1>${monthSw(true)}</div>
    <div class="grid g3">
      <div class="kpi"><span class="small muted">Salário</span><span class="n">${brl0(S.renda)}</span></div>
      <div class="kpi"><span class="small muted">Entradas extras</span><span class="n ok">${brl0(r.extras)}</span></div>
      <div class="kpi"><span class="small muted">Saídas</span><span class="n">${brl0(r.saidas)}</span></div>
      <div class="kpi"><span class="small muted">Sobra</span><span class="n ${r.saldo<0?"bad":r.sp>=20?"ok":"warn"}">${brl0(r.saldo)}</span></div>
    </div>
    <div class="row" style="display:flex;gap:10px;margin:16px 0;flex-wrap:wrap"><button class="btn primary" data-act="saida">${I("dn")} Novo gasto</button><button class="btn" data-act="entrada">${I("up")} Nova entrada</button></div>
    <div class="card"><p class="hintTap">Toque em um lançamento para corrigir o valor, a categoria ou a data.</p>${fixHtml||groups?fixHtml+groups:`<div class="empty">Nenhum lançamento em ${mLabel(mes)}.</div>`}</div></div>`;
}

/* ========== categorias ========== */
function categorias(r){
  const cards=r.rows.map(x=>{
    const w=x.ideal>0?Math.min(100,x.g/Math.max(x.ideal,x.g)*100):0, mk=x.g>x.ideal?x.ideal/x.g*100:100;
    const lbl={ok:"No ideal",warn:"Atenção",bad:"Alerta",neutral:"Sem gastos"}[x.st];
    const msg = x.k==="dividas"
      ? (x.g===0?(r.temDiv?"Você tem dívidas, mas nenhum pagamento lançado este mês.":"Sem dívidas. Toda a fatia dos 20% pode virar sobra."):x.g<=r.renda*.15?"Parcelas sob controle.":x.g<=x.ideal?"As parcelas usam quase toda a fatia dos 20%. Sobra pouco para guardar.":`As parcelas passam de 20% da renda em ${brl0(x.ex)}. Renegocie para alongar o prazo e baixar a parcela.`)
      : x.st==="ok"?`Dentro do ideal. Ainda cabem ${brl0(x.ideal-x.g)} aqui.`:x.st==="neutral"?`Você pode gastar até ${brl0(x.ideal)} nesta categoria.`:`Passou ${brl0(x.ex)} do ideal. Corte esse valor para equilibrar.`;
    const open=openCats.has(x.k);
    return `<div class="cat ${open?"open":""}" data-cat="${x.k}">
      <button aria-expanded="${open}"><span class="ico ${x.st==="neutral"?"":x.st}">${I(x.ic)}</span>
        <span><span style="display:flex;align-items:center;gap:8px;flex-wrap:wrap"><strong>${x.n}</strong><span class="chip ${x.st}">${lbl}</span></span>
        <div class="bar"><i class="${x.st}" style="width:${w}%"></i><b style="left:${mk}%"></b></div>
        <span class="small muted tab">${brl0(x.g)} de ${brl0(x.ideal)} (ideal ${x.k==="dividas"?"até ":""}${x.p}%)</span></span>
        <strong class="pc tab" style="font-size:17px">${pct(x.real)}</strong>
        <span class="chev">${I("down")}</span></button>
      <div class="cbody">
        <div class="status ${x.st}">${msg}</div>
        <h4>O que lançar aqui</h4><p>${x.o}</p>
        <div class="tags" style="margin-top:10px">${x.itens.map(e=>`<span>${e}</span>`).join("")}</div>
        <h4>Como economizar</h4><ul>${x.tips.map(t=>`<li>${t}</li>`).join("")}</ul>
        <button class="btn sm" style="margin-top:14px" data-lcat="${x.k}">${I("plus")} Lançar em ${x.n}</button>
      </div></div>`;
  }).join("");
  return `<div class="content"><div class="pagehead"><h1>Categorias</h1>${monthSw(true)}</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px"><span class="chip ok">No ideal</span><span class="chip warn">Atenção: até 15% acima</span><span class="chip bad">Alerta: mais de 15% acima</span></div>
    <p class="muted" style="margin:0 0 16px">Toque em uma categoria para ver o que lançar e como economizar. Calculado sobre ${brl0(r.renda)} de renda no mês.</p>${cards}</div>`;
}

/* ========== dívidas ========== */
function dividas(r){
  const ativ=S.dividas.filter(d=>d.saldo>0).sort((a,b)=>((b.atraso&&b.tipo==="contas")-(a.atraso&&a.tipo==="contas"))||b.juros-a.juros);
  const total=ativ.reduce((a,d)=>a+d.saldo,0), parc=ativ.reduce((a,d)=>a+d.parcela,0);
  const comp=r.renda?parc/r.renda*100:0, cs=comp<=15?"ok":comp<=30?"warn":"bad";
  const ext=extraDiv??Math.max(0,Math.round(r.saldo));
  const sim=simular(ext), sim0=simular(0);
  const cards=ativ.length?ativ.map((d,i)=>`<div class="debt"><div class="top">
      <div style="display:flex;gap:12px"><span class="rank ${d.juros>=6||d.atraso?"bad":"warn"}">${i+1}</span>
        <div><strong>${esc(d.nome)}</strong><div class="small muted">${TIPOS[d.tipo]?.[0]||""}</div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">${d.atraso?'<span class="chip bad">Em atraso</span>':""}${d.juros>=6?'<span class="chip bad">Juros altos</span>':'<span class="chip neutral">Juros moderados</span>'}${sim&&sim.quit[d.id]?`<span class="chip neutral">Quitada em ~${prazo(sim.quit[d.id])}</span>`:""}</div></div></div>
      <div style="text-align:right"><div style="font-size:22px;font-weight:800" class="tab">${brl0(d.saldo)}</div><div class="small muted tab">${brl0(d.parcela)}/mês</div><div class="small muted">${pct(d.juros)} ao mês${d.restantes?`, ${d.restantes}x restantes`:""}</div></div></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">
        <button class="btn primary sm" data-pay="${d.id}">${I("check")} Paguei a parcela</button>
        <button class="btn sm" data-edit="${d.id}">${I("pencil")} Atualizar</button>
        <button class="btn sm danger" data-rmd="${d.id}" aria-label="Remover dívida">${I("trash")}</button></div></div>`).join("")
    : `<div class="card empty">${I("shield")}<p style="margin:8px 0 14px">Nenhuma dívida cadastrada.<br>Tem cartão atrasado, empréstimo, parcelas ou acordos? Cadastre para montar seu plano.</p><button class="btn primary sm" data-newdebt>${I("plus")} Cadastrar dívida</button></div>`;
  return `<div class="content"><div class="pagehead"><h1>Dívidas</h1><button class="btn primary" data-newdebt>${I("plus")} Cadastrar dívida</button></div>
    <div class="grid g3">
      <div class="kpi"><span class="small muted">Total devido</span><span class="n">${brl0(total)}</span></div>
      <div class="kpi"><span class="small muted">Parcelas por mês</span><span class="n">${brl0(parc)}</span></div>
      <div class="kpi"><span class="small muted">Renda comprometida</span><span class="n ${cs}">${pct(comp)}</span>
        <div class="meter"><i style="width:${Math.min(100,comp/50*100)}%;background:var(--${cs})"></i><span style="left:30%"></span><span style="left:60%"></span></div></div>
    </div>
    ${ativ.length?`<p class="muted small" style="margin:10px 2px 0">${comp>30?"Acima de 30% da renda em parcelas é zona de perigo: renegociar para baixar o valor mensal é a prioridade.":comp>15?"Comprometimento alto. Evite qualquer nova compra parcelada.":"Comprometimento saudável. Mantenha tudo em dia."}</p>`:""}
    <div class="grid g2" style="margin-top:16px;align-items:start">
      <div>
        ${ativ.length?`<div class="cardhead" style="margin:0 2px 10px"><h3>Ordem de pagamento</h3></div><p class="small muted" style="margin:-4px 2px 12px">Contas essenciais atrasadas primeiro, depois juros mais altos. Pague o mínimo de todas e coloque todo dinheiro extra na número 1.</p>`:""}
        ${cards}
        ${ativ.length?`<div class="card" style="margin-top:16px"><h3>Simulador de quitação</h3>
          <label class="f" style="margin-top:12px">Quanto consegue pagar a mais por mês, além das parcelas?<input type="text" inputmode="decimal" id="extraDiv" value="${ext.toLocaleString("pt-BR")}"></label>
          ${sim&&sim.ok?`<div class="alertbox a-ok" style="margin-top:14px;grid-template-columns:1fr"><div><h2 style="font-size:16px">Livre das dívidas em ${prazo(sim.m)}</h2><p class="small">Juros pagos no caminho: cerca de ${brl0(sim.juros)}.${sim0&&sim0.ok&&ext>0?` Pagando só as parcelas seriam ${prazo(sim0.m)} e ${brl0(sim0.juros)} de juros. Você economiza ${brl0(sim0.juros-sim.juros)}.`:""}</p></div></div>`
          :`<div class="alertbox a-bad" style="margin-top:14px;grid-template-columns:1fr"><div><h2 style="font-size:16px">A dívida não está diminuindo</h2><p class="small">Os juros crescem mais rápido que os pagamentos. Negociar é obrigatório.</p></div></div>`}
        </div>`:""}
      </div>
      <div class="card"><h3 style="margin-bottom:6px">Plano para sair das dívidas</h3>
        <ol class="steps">
          <li><strong>Pare de criar dívida nova.</strong> Nada de rotativo, cheque especial ou compra parcelada até quitar.</li>
          <li><strong>Descubra tudo que deve.</strong> Consulte seu CPF no Registrato do Banco Central e no Serasa.</li>
          <li><strong>Garanta o essencial.</strong> Aluguel, luz e água atrasados vêm antes: podem gerar corte ou despejo.</li>
          <li><strong>Negocie as mais caras.</strong> Cartão e cheque especial costumam dar bons descontos. Use Serasa Limpa Nome, Acordo Certo, o app do banco e os mutirões de negociação.</li>
          <li><strong>Troque dívida cara por barata.</strong> Portabilidade de crédito ou consignado podem cortar os juros, se você não voltar a usar o cartão.</li>
          <li><strong>Só aceite acordo que caiba no mês.</strong> Acordo quebrado volta pior.</li>
          <li><strong>Quitou uma? Passe o valor para a próxima.</strong> A parcela liberada vira pagamento extra da seguinte.</li>
        </ol></div>
    </div></div>`;
}

