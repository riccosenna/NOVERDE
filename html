/* ========== sheet ========== */
const bg=document.getElementById("sheetbg"), sh=document.getElementById("sheet");
function openSheet(title,html,bindFn){
  sh.innerHTML=`<div class="grab"></div><div class="sh"><h2 id="shT">${title}</h2><button class="iconbtn" id="shX" aria-label="Fechar">${I("x")}</button></div>${html}`;
  sh.setAttribute("aria-labelledby","shT");
  bg.classList.add("show"); document.getElementById("shX").onclick=closeSheet; bindFn&&bindFn();
  setTimeout(()=>sh.querySelector("input")?.focus(),60);
}
function closeSheet(){ bg.classList.remove("show"); sh.innerHTML=""; }
bg.addEventListener("click",e=>{ if(e.target===bg) closeSheet(); });
document.addEventListener("keydown",e=>{ if(e.key==="Escape"&&bg.classList.contains("show")) closeSheet(); });

function openLanc(tipo,cat,item){
  const ed=!!item;
  let t=ed?item.tipo:tipo, c=ed?(item.cat||"moradia"):(cat||"moradia");
  const keep=()=>{ keep.v=document.getElementById("sV")?.value||""; keep.d=document.getElementById("sD")?.value||""; keep.dt=document.getElementById("sDt")?.value||keep.dt; keep.f=document.getElementById("sF")?.checked??keep.f; };
  keep.v=ed?item.valor.toLocaleString("pt-BR",{minimumFractionDigits:2}):""; keep.d=ed?(item.desc||""):"";
  keep.dt=ed?(item.fixo?item.desde+"-01":item.data):(mes===curM()?today():mes+"-01"); keep.f=ed?item.fixo:false;
  const draw=()=>{
    const ent=t==="entrada", cc=CAT[c];
    const title=ed?(ent?"Editar entrada":"Editar gasto"):(ent?"Nova entrada":"Novo gasto");
    openSheet(title,`
      <div class="seg"><button data-t="saida" aria-pressed="${!ent}">Saiu dinheiro</button><button data-t="entrada" aria-pressed="${ent}">Entrou dinheiro</button></div>
      <label class="f" style="margin-top:18px">Valor<div class="money"><span>R$</span><input type="text" inputmode="decimal" id="sV" placeholder="0,00" autocomplete="off"></div></label>
      ${ent?`<p class="small muted">Seu salário de ${brl0(S.renda)} já entra todo mês. Lance aqui só o dinheiro extra: bico, venda, 13º, restituição.</p>`:`
      <div class="f" style="margin-top:18px">Categoria</div>
      <div class="catpick" style="margin-top:8px">${CATS.map(x=>`<button data-c="${x.k}" aria-pressed="${x.k===c}">${I(x.ic)}${x.n.replace(" e parcelas","")}</button>`).join("")}</div>
      <div class="explain" style="margin-top:10px"><strong>O que entra em ${cc.n}</strong>${cc.o}<div class="tags">${cc.itens.slice(0,9).map(e=>`<span>${e}</span>`).join("")}</div></div>`}
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:10px;margin-top:16px">
        <label class="f">Descrição<input type="text" id="sD" placeholder="${ent?"Ex.: venda":"Ex.: conta de luz"}"></label>
        <label class="f">${keep.f&&!ent?"Começa em":"Data"}<input type="date" id="sDt"></label></div>
      ${ent?"":`<label class="switch" style="margin-top:16px"><span>Gasto fixo, repete todo mês<br><span class="small muted" style="font-weight:500">Aluguel, escola, plano, assinaturas</span></span><input type="checkbox" id="sF" ${keep.f?"checked":""}></label>`}
      ${ed&&item.fixo?`<p class="small muted" style="margin:10px 0 0">Alterar um gasto fixo muda o valor em todos os meses em que ele aparece.</p>`:""}
      <button class="btn primary block" style="margin-top:20px" id="sOk">${ed?"Salvar alterações":ent?"Adicionar entrada":"Adicionar gasto"}</button>
      ${ed?`<button class="btn danger block" style="margin-top:10px" id="sDel">${I("trash")} Excluir ${ent?"entrada":"lançamento"}</button>`:""}`,
    ()=>{
      sh.querySelectorAll("[data-t]").forEach(b=>b.onclick=()=>{ keep(); t=b.dataset.t; draw(); });
      sh.querySelectorAll("[data-c]").forEach(b=>b.onclick=()=>{ keep(); c=b.dataset.c; draw(); });
      document.getElementById("sV").value=keep.v; document.getElementById("sD").value=keep.d; document.getElementById("sDt").value=keep.dt;
      const sf=document.getElementById("sF"); if(sf) sf.onchange=()=>{ keep(); draw(); };
      if(ed){ document.getElementById("sDel").onclick=()=>{ closeSheet(); delTx((item.fixo?"f:":"l:")+item.id); }; }
      document.getElementById("sOk").onclick=()=>{
        const v=parseV(document.getElementById("sV").value); if(v<=0){toast("Digite o valor");return;}
        const desc=document.getElementById("sD").value.trim(), data=document.getElementById("sDt").value||today();
        const fixo=!ent && document.getElementById("sF").checked;
        const snap=JSON.stringify({l:S.lanc,f:S.fixos});
        const id=ed?item.id:uid();
        if(ed){ S.lanc=S.lanc.filter(x=>x.id!==id); if(!(item.fixo&&fixo)) S.fixos=S.fixos.filter(x=>x.id!==id); }
        if(fixo){ const f=S.fixos.find(x=>x.id===id); if(f) Object.assign(f,{valor:v,cat:c,desc,desde:data.slice(0,7)}); else S.fixos.push({id,valor:v,cat:c,desc,desde:data.slice(0,7)}); }
        else S.lanc.push({id,tipo:t,valor:v,cat:ent?null:c,desc,data});
        mes=data.slice(0,7); save(); closeSheet(); render();
        const undo=()=>{ const o=JSON.parse(snap); S.lanc=o.l; S.fixos=o.f; save(); render(); };
        if(ed){ toast("Alterações salvas","Desfazer",undo); return; }
        const row=calc(mes).rows.find(x=>x.k===c);
        toast(ent?"Entrada adicionada":row.st==="bad"?`Gasto adicionado. ${row.n} passou do ideal`:row.st==="warn"?`Gasto adicionado. Atenção em ${row.n}`:"Gasto adicionado","Desfazer",undo);
      };
    });
  };
  draw();
}
function openDebt(d){
  const ed=!!d; d=d||{nome:"",tipo:"cartao",saldo:"",parcela:"",juros:14,restantes:"",atraso:false};
  const opts=Object.entries(TIPOS).map(([k,[n]])=>`<option value="${k}" ${k===d.tipo?"selected":""}>${n}</option>`).join("");
  const v=x=>x===""?"":Number(x).toLocaleString("pt-BR");
  openSheet(ed?"Atualizar dívida":"Cadastrar dívida",`<div class="grid" style="gap:12px">
    <label class="f">Nome<input type="text" id="dN" value="${esc(d.nome)}" placeholder="Ex.: Cartão Nubank, Empréstimo Caixa"></label>
    <label class="f">Tipo<select id="dT">${opts}</select></label>
    <div class="grid" style="grid-template-columns:1fr 1fr;gap:10px">
      <label class="f">Quanto deve hoje<input type="text" inputmode="decimal" id="dS" value="${v(d.saldo)}" placeholder="0,00"></label>
      <label class="f">Parcela por mês<input type="text" inputmode="decimal" id="dP" value="${v(d.parcela)}" placeholder="0,00"></label>
      <label class="f">Juros ao mês (%)<input type="text" inputmode="decimal" id="dJ" value="${v(d.juros)}"></label>
      <label class="f">Parcelas restantes<input type="number" min="0" id="dR" value="${d.restantes||""}" placeholder="Opcional"></label></div>
    <p class="small muted" style="margin:0">Não sabe os juros? Usamos uma média pelo tipo. Confira no app ou extrato do banco.</p>
    <label class="switch"><span>Está em atraso</span><input type="checkbox" id="dA" ${d.atraso?"checked":""}></label>
    <button class="btn primary block" id="dOk">${ed?"Salvar alterações":"Cadastrar dívida"}</button></div>`,
  ()=>{
    const dt=document.getElementById("dT"); if(!ed) dt.onchange=()=>{document.getElementById("dJ").value=String(TIPOS[dt.value][1]).replace(".",",")};
    document.getElementById("dOk").onclick=()=>{
      const nome=document.getElementById("dN").value.trim(), saldo=parseV(document.getElementById("dS").value), parcela=parseV(document.getElementById("dP").value);
      if(!nome||saldo<=0){toast("Preencha o nome e quanto deve");return;}
      const o={nome,tipo:dt.value,saldo,parcela:parcela||Math.round(saldo*.05),juros:parseV(document.getElementById("dJ").value),restantes:parseInt(document.getElementById("dR").value)||0,atraso:document.getElementById("dA").checked};
      if(ed) Object.assign(S.dividas.find(x=>x.id===d.id),o); else S.dividas.push({id:uid(),...o});
      save(); closeSheet(); render(); toast(ed?"Dívida atualizada":"Dívida cadastrada");
    };
  });
}

/* ========== eventos ========== */
function bindCommon(r){
  const root=document.getElementById("root");
  root.querySelectorAll("[data-v]").forEach(b=>b.onclick=()=>{ view=b.dataset.v; render(); scrollTo(0,0); });
  root.querySelectorAll("[data-m]").forEach(b=>b.onclick=()=>{ mes=shiftM(mes,+b.dataset.m); render(); });
  root.querySelectorAll("[data-act]").forEach(b=>b.onclick=()=>openLanc(b.dataset.act));
  const eye=document.getElementById("eye"); if(eye) eye.onclick=()=>{ S.hide=!S.hide; save(); render(); };
  root.querySelectorAll("[data-del]").forEach(b=>b.onclick=e=>{ e.stopPropagation(); delTx(b.dataset.del); });
  root.querySelectorAll("[data-edit-tx]").forEach(b=>b.onclick=e=>{ e.stopPropagation(); openLanc(null,null,findTx(b.dataset.editTx)); });
  root.querySelectorAll("[data-open]").forEach(el=>{ const go=()=>openLanc(null,null,findTx(el.dataset.open)); el.onclick=go; el.onkeydown=e=>{ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); go(); } }; });
  root.querySelectorAll(".cat>button").forEach(b=>b.onclick=()=>{ const k=b.parentElement.dataset.cat; openCats.has(k)?openCats.delete(k):openCats.add(k); b.parentElement.classList.toggle("open"); b.setAttribute("aria-expanded",openCats.has(k)); });
  root.querySelectorAll("[data-lcat]").forEach(b=>b.onclick=()=>openLanc("saida",b.dataset.lcat));
  root.querySelectorAll("[data-newdebt]").forEach(b=>b.onclick=()=>openDebt());
  root.querySelectorAll("[data-edit]").forEach(b=>b.onclick=()=>openDebt(S.dividas.find(x=>x.id===b.dataset.edit)));
  root.querySelectorAll("[data-rmd]").forEach(b=>b.onclick=()=>{ if(!confirm("Remover esta dívida?")) return; S.dividas=S.dividas.filter(x=>x.id!==b.dataset.rmd); save(); render(); });
  root.querySelectorAll("[data-pay]").forEach(b=>b.onclick=()=>{
    const d=S.dividas.find(x=>x.id===b.dataset.pay), v=Math.min(d.parcela,d.saldo*(1+d.juros/100));
    S.lanc.push({id:uid(),tipo:"saida",valor:Math.round(v*100)/100,cat:"dividas",desc:"Parcela: "+d.nome,data:mes===curM()?today():mes+"-01"});
    d.saldo=Math.max(0,Math.round((d.saldo*(1+d.juros/100)-v)*100)/100); if(d.restantes) d.restantes--; d.atraso=false;
    if(d.restantes===0&&d.saldo<d.parcela*.05) d.saldo=0;
    save(); render(); toast(d.saldo>0?"Parcela lançada em Dívidas":"Dívida quitada! Passe esse valor para a próxima");
  });
  const ex=document.getElementById("extraDiv"); if(ex) ex.onchange=()=>{ extraDiv=Math.max(0,parseV(ex.value)); render(); };
  if(view==="perfil"){
    document.getElementById("pSave").onclick=()=>{ const v=parseV(document.getElementById("pR").value); if(v<=0){toast("Digite um valor maior que zero");return;} S.renda=v; save(); render(); toast("Renda atualizada"); };
    document.getElementById("pExp").onclick=()=>{ const a=document.createElement("a"); a.href=URL.createObjectURL(new Blob([JSON.stringify(S,null,2)],{type:"application/json"})); a.download="noverde-backup-"+today()+".json"; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),1000); toast("Backup exportado"); };
    document.getElementById("pImp").onchange=e=>{ const f=e.target.files[0]; if(!f) return; const rd=new FileReader(); rd.onload=()=>{ try{ const d=JSON.parse(rd.result); if(typeof d.renda!=="number"||!Array.isArray(d.lanc)) throw 0; S=Object.assign({renda:0,lanc:[],fixos:[],dividas:[],hide:false},d); save(); view="inicio"; render(); toast("Backup importado"); }catch(err){ toast("Arquivo inválido: use um backup do NOVERDE"); } }; rd.readAsText(f); };
    document.getElementById("pDemo").onclick=()=>{ if(confirm("Substituir seus dados pelo exemplo?")) loadDemo(); };
    document.getElementById("pReset").onclick=()=>{ if(!confirm("Apagar renda, lançamentos e dívidas? Não dá para desfazer.")) return; S={renda:0,nome:"",lanc:[],fixos:[],dividas:[],hide:false}; save(); view="inicio"; render(); };
  }
}

