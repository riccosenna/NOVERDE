  return `<div class="welcome"><div class="box">
    ${mark()}
    <h1>Saia do vermelho e fique no verde.</h1>
    <p>O NOVERDE mostra onde o seu dinheiro está escapando, diz onde cortar e organiza suas dívidas até sobrarem 20% do que você ganha todo mês.</p>
    <label class="f" style="color:rgba(255,255,255,.75)">Quanto você recebe por mês, já com descontos?
      <div class="money"><span>R$</span><input type="text" inputmode="decimal" id="wR" placeholder="0,00" autocomplete="off"></div></label>
    <p class="small" style="margin:10px 0 24px">Se a renda varia, use a média dos últimos 3 meses. Dinheiro extra você lança depois como entrada.</p>
    <div class="grid" style="gap:10px">
      <button class="btn primary block" id="wGo">Começar</button>
      <button class="btn ghost block" id="wDemo">Ver com um exemplo</button>
    </div>
  </div></div>`;
}
function bindWelcome(){
  document.getElementById("wGo").onclick=()=>{ const v=parseV(document.getElementById("wR").value); if(v<=0){toast("Digite sua renda mensal");return;} S.renda=v; save(); view="inicio"; render(); setTimeout(()=>openLanc("saida"),250); };
  document.getElementById("wDemo").onclick=loadDemo;
}

/* ========== início ========== */
function donut(rows,total){
  const R=60,C=2*Math.PI*R; let off=0;
  const segs = total>0 ? rows.filter(x=>x.g>0).map(x=>{ const len=x.g/total*C; const s=`<circle r="${R}" cx="80" cy="80" fill="none" stroke="${x.col}" stroke-width="22" stroke-dasharray="${Math.max(0,len-2)} ${C}" stroke-dashoffset="${-off}" transform="rotate(-90 80 80)"/>`; off+=len; return s; }).join("") : "";
  return `<svg viewBox="0 0 160 160" width="160" height="160" role="img" aria-label="Distribuição dos gastos por categoria">
    <circle r="${R}" cx="80" cy="80" fill="none" stroke="var(--surface2)" stroke-width="22"/>${segs}
    <text x="80" y="76" text-anchor="middle" font-size="11" fill="var(--muted)" font-family="inherit">Saiu</text>
    <text x="80" y="95" text-anchor="middle" font-size="16" font-weight="800" fill="var(--ink)" font-family="inherit">${brl0(total)}</text></svg>`;
}
function inicio(r){
  const f=fase(r), meta=r.renda*.2, hid=S.hide;
  const H = v => hid?"R$ ••••":brl(v);
  const top=r.rows.filter(x=>x.ex>0).sort((a,b)=>b.ex-a.ex);
  const prog = r.saldo<0 ? Math.min(100,-r.saldo/r.renda*100*2) : Math.min(100,r.saldo/meta*100);
  const totalAj=top.reduce((a,x)=>a+x.ex,0), saldoPos=r.saldo+totalAj;
  const parc=S.dividas.filter(d=>d.saldo>0).reduce((a,d)=>a+d.parcela,0);

  let aT,aP,aC,aI;
  if(r.saidas===0){aC="warn";aI="list";aT="Lance seus gastos para receber o diagnóstico";aP="Comece pelos fixos: aluguel, contas da casa, escola e plano de saúde. Depois registre cada saída do dia a dia.";}
  else if(r.saldo<0){aC="bad";aI="alert";aT=`Você está ${brl0(-r.saldo)} no vermelho`;aP=top.length?`O maior vazamento é ${top[0].n}: ${brl0(top[0].ex)} acima do ideal. Corte aqui primeiro.`:"Os gastos estão no ideal, mas a renda não cobre. Renegocie dívidas e busque renda extra.";}
  else if(r.sp<20){aC="warn";aI="target";aT=`Faltam ${brl0(meta-r.saldo)} para a meta de 20%`;aP=top.length?`Ajustando ${top[0].n} você se aproxima da meta.`:r.temDiv?"Use a sobra para antecipar a dívida mais cara.":"Continue registrando tudo para não deixar nada de fora.";}
  else {aC="ok";aI="shield";aT=`Meta batida: ${pct(r.sp)} de sobra`;aP=r.temDiv?"Use a sobra para quitar a dívida mais cara mais rápido.":"Guarde na reserva de emergência (6 meses de custo) e depois invista.";}

  const cuts = top.length ? top.map((x,i)=>`<div class="li"><span class="rank ${x.st==="warn"?"warn":"bad"}">${i+1}</span>
      <div><div class="t">${x.n}</div><div class="s">${brl0(x.g)} gastos. Ideal até ${brl0(x.ideal)} (${x.p}%)</div></div>
      <div class="v bad">-${brl0(x.ex)}</div></div>`).join("")
    + `<div class="small muted" style="margin-top:12px">${saldoPos<0?`Mesmo cortando tudo, ainda faltariam ${brl0(-saldoPos)}. O custo fixo está alto para a renda: renegocie dívidas e busque renda extra.`:`Cortando esses valores, o mês fecha com sobra de <strong class="ok">${brl0(saldoPos)}</strong> (${pct(saldoPos/r.renda*100)}).`}</div>`
    : r.saidas===0 ? `<div class="empty">Nenhum gasto neste mês.<br><button class="btn primary sm" style="margin-top:12px" data-act="saida">${I("plus")} Lançar gasto</button></div>`
    : `<div class="li"><span class="ico ok">${I("check")}</span><div><div class="t">Tudo dentro do ideal</div><div class="s">Nenhuma categoria passou do limite.</div></div><span></span></div>`;

  const leg = r.rows.map(x=>`<div><i style="background:${x.col}"></i><span>${x.n}</span><span class="tab muted">${pct(x.real)}</span><span class="sd ${x.st}" title="${({ok:"No ideal",warn:"Atenção",bad:"Alerta",neutral:"Sem gastos"})[x.st]}"></span></div>`).join("");

  return `<section class="hero"><div class="content">
      <div class="heroTop"><span class="heroMark">${mark(false)}</span>${monthSw()}</div>
      <div class="balLbl">Sobra do mês <button id="eye" aria-label="${hid?"Mostrar":"Esconder"} valores">${I(hid?"eyeoff":"eye")}</button></div>
      <div class="bal tab">${H(r.saldo)}</div>
      <div class="heroRow"><div><span class="up">${I("up")}</span>Entrou <strong class="tab">${H(r.renda)}</strong></div><div><span class="down">${I("dn")}</span>Saiu <strong class="tab">${H(r.saidas)}</strong></div></div>
